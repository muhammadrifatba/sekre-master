# ============================================================================
# SEKRE v3 + WorkBuddy Master Profiler — Environment Variables Template
# Copy to backend/.env locally, or paste into Vercel Project Settings -> Env Vars
# ============================================================================

# Supabase PostgreSQL (Transaction Pooler & Direct Connection)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres"

# HMAC-SHA256 Audit Chain Secret (generate: python -c "import secrets; print(secrets.token_hex(32))")
AUDIT_HMAC_KEY=replace_with_64_char_random_hex

# JWT Secret for Website Login (/auth/login)
JWT_SECRET_KEY=replace_with_strong_random_secret

# RBAC Owners
DEFAULT_OWNER=owner_rifat
AUTHORIZED_OWNERS=owner_rifat,owner_andi

# Optional: Additional allowed frontend origins (comma-separated; *.vercel.app is allowed automatically)
CORS_ORIGINS=http://localhost:3000

# Optional: Protect remote /mcp/* endpoints on Vercel with Bearer token
MCP_API_KEY=
